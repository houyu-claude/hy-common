<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 依赖版本管理与插件配置基础 POM. https://spring.io/projects/spring-boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0-RC1</version>
        <relativePath/>
    </parent>

    <groupId>com.houyu</groupId>
    <artifactId>hy-common</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <description>侯余通用依赖版本管理</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <!-- Spring Cloud Alibaba 微服务组件依赖版本 BOM. https://sca.aliyun.com/ -->
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- JetCache 缓存框架版本. https://github.com/alibaba/jetcache -->
        <jetcache.version>2.7.9-SNAPSHOT</jetcache.version>
        <!-- Java 样板代码生成工具版本. https://projectlombok.org/ -->
        <lombok.version>1.18.46</lombok.version>
        <!-- Bean 映射框架版本. https://mapstruct.org/ -->
        <mapstruct.version>1.7.0.Beta1</mapstruct.version>
        <!-- Maven POM 展平插件版本. https://www.mojohaus.org/flatten-maven-plugin/ -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <!-- 单元测试覆盖率统计插件版本. https://www.jacoco.org/jacoco/trunk/doc/maven.html -->
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud Alibaba 微服务组件依赖版本 BOM，集成 Nacos/Sentinel/Seata 等. https://sca.aliyun.com/ -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JetCache 缓存框架 BOM，支持本地与分布式缓存、TTL 管理、自动刷新. https://github.com/alibaba/jetcache -->
            <dependency>
                <groupId>com.alicp.jetcache</groupId>
                <artifactId>jetcache-bom</artifactId>
                <version>${jetcache.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Java 样板代码生成工具，通过注解自动生成 getter/setter/builder/constructor 等. https://projectlombok.org/ -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Bean 映射框架，编译期生成类型安全的映射代码，零运行时依赖. https://mapstruct.org/ -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Bean 映射注解处理器，配合 mapstruct 在编译期生成映射实现. https://mapstruct.org/ -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 展平 Maven POM 文件，解决多模块 ${revision} 版本占位符发布问题. https://www.mojohaus.org/flatten-maven-plugin/ -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 统计单元测试覆盖率. CVE-2025-67030. https://www.jacoco.org/jacoco/trunk/doc/maven.html -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- JetCache 2.7.9-SNAPSHOT 构件来源仓库 -->
        <repository>
            <id>sonatype-snapshots</id>
            <name>Sonatype OSS Snapshots</name>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>
</project>
